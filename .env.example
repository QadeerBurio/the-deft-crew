# Database configuration
MONGO_URI=mongodb://localhost:27017/myDatabase
BACKEND_MONGO_URI=mongodb://localhost:27017/myDatabase

# Server configuration
PORT=5000
NODE_ENV=development
CORS_ORIGIN=*

# JWT authentication secret
JWT_SECRET=your_jwt_secret_here

# OpenAI configuration
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_MAX_OUTPUT_TOKENS=3000
OPENAI_TEMPERATURE=0.3

# Cloudinary configuration (Optional, falls back to local storage if omitted)
CLOUDINARY_NAME=your_cloudinary_name_here
CLOUDINARY_KEY=your_cloudinary_key_here
CLOUDINARY_SECRET=your_cloudinary_secret_here

# Chatbot AI Configs
TOP_K_RESULTS=5
MAX_CONTEXT_DOCUMENTS=5
MAX_CONTEXT_CHARACTERS=12000
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
SYNC_INTERVAL_MINUTES=30

# Adzuna API Credentials
ADZUNA_APP_ID=your_adzuna_app_id_here
ADZUNA_APP_KEY=your_adzuna_app_key_here
